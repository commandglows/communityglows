---
import Layout from '../../layouts/Layout.astro'
import Navbar from '../../components/Navbar.astro'
import Footer from '../../components/Footer.astro'
import { appUrl, authenticatedPurchaseUrl } from '../../config/site'
import ActionLink from '../../components/ui/ActionLink.astro'
import EyebrowPill from '../../components/ui/EyebrowPill.astro'

const copy = {
  "title": "Essai et accès à vie — CommunityGlows",
  "description": "Préversion Windows, essai de 30 jours avec deux relances facultatives et tarif de 149 € TTC sans abonnement. Consultez les conditions et la disponibilité dans l’application.",
  "eyebrow": "Le lancement commence sur Windows",
  "heading": "Un espace pour vos communautés, sans abonnement.",
  "intro": "Découvrez la préversion Windows avant de choisir un accès à vie. Réunissez vos profils, vos réseaux et vos liens utiles dans un espace de travail dédié.",
  "download": "Télécharger la préversion Windows",
  "access": "Vérifier l’accès dans l’application",
  "note": "L’ouverture publique des parcours d’essai et de paiement est en cours de finalisation. Le téléchargement de la préversion ne garantit pas que l’achat soit déjà disponible.",
  "price": "149 € · paiement unique",
  "offer": "Les conditions prévues",
  "trial": "Une période de 30 jours, jusqu’à deux relances facultatives, sans carte bancaire ni facturation automatique. Après la troisième période, un achat est nécessaire pour continuer à utiliser les fonctionnalités soumises à l’accès payant.",
  "includes": [
    "Espace multi-profils Windows avec sessions locales",
    "Catalogue de réseaux, liens personnalisés et préférences de concentration selon le réseau",
    "Synchronisation des profils et préférences via votre compte",
    "Sauvegarde et restauration locales"
  ],
  "boundaryTitle": "Ce que vous pouvez attendre",
  "boundaries": [
    "Windows est actuellement la seule préversion téléchargeable publiquement. Android et les extensions Chrome et Firefox ne sont pas encore distribués publiquement.",
    "Bento, Scènes et Tâches évoluent encore. Consultez les notes de votre version installée ; les améliorations à venir ne sont pas une garantie d’inclusion dans l’installeur actuel.",
    "La séparation des profils réduit les mélanges accidentels de sessions. Elle ne contourne pas les règles des réseaux et ne garantit pas l’anonymat.",
    "Les réseaux sociaux peuvent modifier leurs connexions, interfaces et règles. La compatibilité dépend de chaque service.",
    "Les profils et préférences peuvent être synchronisés ; les sessions de connexion restent sur l’appareil, sauf export de sauvegarde explicite."
  ],
  "faqTitle": "Questions sur l’accès",
  "faq": [
    [
      "Comment fonctionne l’achat ?",
      "Lorsqu’il est disponible, ouvrez CommunityGlows et connectez-vous à votre compte. Le paiement démarre depuis l’application et s’ouvre dans Stripe via CommandGlows. Vérifiez le prix et les conditions avant de confirmer."
    ],
    [
      "Pourquoi CommandGlows apparaît-il au paiement ?",
      "CommandGlows gère le paiement Stripe et rattache l’accès CommunityGlows à votre compte."
    ],
    [
      "L’essai se renouvelle-t-il automatiquement ?",
      "Non. Les deux relances sont facultatives et se déclenchent dans l’application lorsqu’elles sont disponibles. Aucun prélèvement automatique n’est prévu."
    ],
    [
      "Les fonctions à venir sont-elles garanties ?",
      "Non. Choisissez le produit pour les fonctions présentes dans la version que vous pouvez utiliser. Les dates et disponibilités futures ne sont pas promises."
    ],
    [
      "Que faire si l’application ne s’ouvre pas ?",
      "Installez d’abord la préversion Windows, puis ouvrez ses paramètres d’accès. Consultez le centre d’aide si le lien du site ne lance pas l’application."
    ]
  ],
  "help": "Consulter le centre d’aide"
}
const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: copy.faq.map(([question, answer]) => ({
    '@type': 'Question', name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
}]
---

<Layout title={copy.title} description={copy.description} path="/fr/lifetime-deal" lang="fr" jsonLd={jsonLd}>
  <main id="main-content" class="min-h-screen bg-background text-foreground">
    <Navbar lang="fr" languageHref="/lifetime-deal" />
    <section class="mx-auto max-w-5xl px-4 pt-32 pb-16 text-center">
      <EyebrowPill>{copy.eyebrow}</EyebrowPill>
      <h1 class="mt-6 text-4xl sm:text-6xl font-bold tracking-tight">{copy.heading}</h1>
      <p class="mx-auto mt-6 max-w-3xl text-lg leading-relaxed text-muted-foreground">{copy.intro}</p>
      <div class="mt-8 flex flex-col sm:flex-row justify-center gap-4">
        <ActionLink href={appUrl('', 'fr')} size="md">{copy.download}</ActionLink>
        <ActionLink href={authenticatedPurchaseUrl()} variant="secondary" size="md">{copy.access}</ActionLink>
      </div>
      <p class="mx-auto mt-6 max-w-3xl text-sm leading-relaxed text-muted-foreground">{copy.note}</p>
      <a class="mt-4 inline-block underline underline-offset-4" href="/fr/help">{copy.help}</a>
    </section>
    <section class="mx-auto max-w-5xl px-4 py-12">
      <div class="rounded-2xl border border-border bg-card p-6 sm:p-10">
        <p class="text-sm text-muted-foreground">{copy.offer}</p>
        <h2 class="mt-3 text-3xl font-bold">{copy.price}</h2>
        <p class="mt-5 leading-relaxed text-muted-foreground">{copy.trial}</p>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2">
          {copy.includes.map(item => <li class="rounded-xl bg-background p-4">{item}</li>)}
        </ul>
      </div>
    </section>
    <section class="mx-auto max-w-5xl px-4 py-12">
      <h2 class="text-3xl font-bold">{copy.boundaryTitle}</h2>
      <ul class="mt-6 space-y-4">
        {copy.boundaries.map(item => <li class="rounded-xl border border-border bg-card p-5 leading-relaxed text-muted-foreground">{item}</li>)}
      </ul>
    </section>
    <section class="mx-auto max-w-5xl px-4 py-12 pb-20">
      <h2 class="text-3xl font-bold">{copy.faqTitle}</h2>
      <div class="mt-6 space-y-4">
        {copy.faq.map(([question, answer]) => <article class="rounded-xl border border-border bg-card p-5"><h3 class="font-semibold">{question}</h3><p class="mt-3 leading-relaxed text-muted-foreground">{answer}</p></article>)}
      </div>
    </section>
    <Footer lang="fr" languageHref="/lifetime-deal" />
  </main>
</Layout>

