---
import Layout from '../../layouts/Layout.astro'
import Navbar from '../../components/Navbar.astro'
import Footer from '../../components/Footer.astro'
import { appUrl, authenticatedPurchaseUrl, siteUrl } from '../../config/site'

const offerId = 'communityglows/lifetime_deal'
const purchaseUrl = authenticatedPurchaseUrl()
const workflow = [
  { step: '01', title: 'Ouvrez chaque compte sans chaos', text: "Réunissez vos réseaux et profils dans un espace concentré plutôt que de multiplier les fenêtres." },
  { step: '02', title: 'Préservez le contexte de chaque profil', text: "Séparez plus facilement les échanges personnels, clients et de marque grâce aux sessions liées aux profils et à l'état local de l'espace." },
  { step: '03', title: "Transformez l'attention en suivi", text: "Passez de la consultation aux idées, réponses, notes de campagne et prochaines actions sans quitter votre système." },
]
const includes = [
  "Accès à CommunityGlows Pro selon les conditions publiées de l'offre à vie",
  'Espace social multi-profils pour créateurs et équipes',
  'Contrôles anti-distraction, liens personnalisés, sauvegarde et restauration',
  'Espace CRM et Kanban présenté séparément comme étant en développement',
  "Orientation ordinateur et mobile à mesure que les versions sont publiées",
  "Accès fourni par le système de commerce et de droits de la suite CommandGlows",
  "Support pour la vérification du compte, le paiement, les remboursements et les événements rejoués",
]
const boundaries = [
  "Les réseaux sociaux peuvent modifier leurs interfaces et règles ; le travail de compatibilité est continu.",
  "La disponibilité future des plateformes suit les versions publiées et les notes produit publiques.",
  "La synchronisation concerne les profils et préférences ; les sessions de connexion restent locales à chaque appareil.",
  "L’achat démarre dans l’application CommunityGlows authentifiée, puis ouvre le paiement Stripe central.",
]
const faq = [
  { q: "Que se passe-t-il après avoir choisi l'accès à vie ?", a: "Le bouton ouvre CommunityGlows. Après connexion, l’application demande un handoff signé de courte durée puis ouvre le paiement Stripe sécurisé, afin de rattacher l’achat à votre compte." },
  { q: 'Pourquoi le paiement passe-t-il par CommandGlows ?', a: "CommandGlows fournit le paiement Stripe et le système d'accès partagés utilisés par CommunityGlows, afin que votre achat et votre accès restent liés." },
  { q: "Que comprend l’essai de 30 jours ?", a: "Chaque période comprend toutes les fonctions CommunityGlows disponibles aujourd’hui. La première dure 30 jours et vous pouvez la relancer deux fois. Après la troisième période, l’achat est obligatoire pour continuer les actions protégées." },
  { q: "L'offre peut-elle évoluer ?", a: "Oui. Sa disponibilité, son prix, ses limites et ses conditions peuvent évoluer. Les conditions affichées au moment du paiement s'appliquent à votre achat." },
]
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'Product', name: 'Offre à vie CommunityGlows', description: 'Essayez CommunityGlows par périodes de 30 jours avec deux relances maximum, puis achetez l’accès à vie via Stripe pour continuer.', brand: { '@type': 'Brand', name: 'CommunityGlows' }, offers: { '@type': 'Offer', availability: 'https://schema.org/InStock', price: '79', priceCurrency: 'EUR', url: siteUrl('/fr/lifetime-deal') } },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })) },
]
---

<Layout title="Essai 30 jours et accès à vie à 79 € — CommunityGlows" description="Essayez toutes les fonctions CommunityGlows disponibles aujourd’hui pendant 30 jours, sans carte ni facturation automatique, puis choisissez l’accès à vie pour 79 €." path="/fr/lifetime-deal" lang="fr" jsonLd={jsonLd}>
  <main id="main-content" class="min-h-screen bg-background text-foreground">
    <Navbar lang="fr" languageHref="/lifetime-deal" />
    <div class="relative z-20 mx-auto -mb-24 flex max-w-6xl justify-center px-4 pt-24 lg:justify-end">
      <span class="rounded-full border border-foreground/20 bg-background px-4 py-2 text-sm font-semibold text-foreground">79 € · paiement unique</span>
    </div>
    <section class="relative overflow-hidden border-b border-border pb-20 pt-32"><div class="absolute inset-0 bg-gradient-to-b from-card to-background" aria-hidden="true"></div><div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 lg:grid-cols-2"><div><p class="inline-flex rounded-full border border-border bg-card px-4 py-2 text-xs font-semibold uppercase tracking-wide text-muted-foreground">Offre fondateur à vie</p><h1 class="mt-6 text-4xl font-bold tracking-tight sm:text-6xl">Restez présent pour votre communauté, sans le chaos des onglets.</h1><p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted-foreground">Réunissez comptes, conversations et prochaines actions dans un espace concentré, afin de réserver davantage d'attention aux personnes derrière les notifications.</p><div class="mt-8 flex flex-col gap-3 sm:flex-row"><a href={appUrl()} class="shimmer-btn inline-flex justify-center rounded-full bg-white px-6 py-3 text-sm font-semibold text-zinc-950 hover:bg-zinc-200">Essayer 30 jours gratuitement</a><a href={purchaseUrl} class="inline-flex justify-center rounded-full border border-border bg-card px-6 py-3 text-sm font-semibold hover:bg-muted">Ouvrir l’app pour payer avec Stripe</a></div></div><div class="rounded-2xl border border-border bg-card p-5 shadow-2xl"><p class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">CommunityGlows</p><p class="mt-1 text-lg font-semibold">Espace communautaire</p><div class="mt-6 grid gap-3 sm:grid-cols-3">{[['Profils','∞'],['Réseaux','18+'],['Formule','Pro']].map(([label,value]) => <div class="rounded-xl bg-background p-4"><p class="text-xs text-muted-foreground">{label}</p><p class="mt-2 text-3xl font-bold">{value}</p></div>)}</div><div class="mt-4 rounded-xl border border-border p-4"><p class="text-xs font-semibold uppercase text-muted-foreground">Prochaine action</p><p class="mt-2 text-sm">Réponses chaleureuses et notes de suivi</p></div></div></div></section>
    <section class="mx-auto max-w-6xl px-4 py-16"><div class="grid gap-8 lg:grid-cols-2"><div><p class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">Pourquoi cet espace compte</p><h2 class="mt-3 text-3xl font-bold">Une communauté grandit grâce aux détails retenus et à une attention renouvelée.</h2></div><p class="text-lg leading-relaxed text-muted-foreground">L'offre à vie vous donne un espace durable pour écouter, répondre et tenir vos engagements. CommunityGlows garde profils et contexte de travail proches pour vous aider à construire une présence plus humaine et régulière.</p></div></section>
    <section class="mx-auto max-w-6xl px-4 py-16"><div class="rounded-2xl border border-border bg-card p-6 sm:p-8"><p class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">Votre rythme</p><h2 class="mt-3 text-3xl font-bold">Du bruit social à une présence qui dure.</h2><div class="mt-8 grid gap-4 md:grid-cols-3">{workflow.map((item) => <div class="rounded-xl border border-border bg-background p-5"><p class="text-xs font-semibold uppercase text-muted-foreground">Étape {item.step}</p><h3 class="mt-3 text-xl font-semibold">{item.title}</h3><p class="mt-3 text-sm leading-relaxed text-muted-foreground">{item.text}</p></div>)}</div></div></section>
    <section id="offer" class="mx-auto grid max-w-6xl gap-8 px-4 py-16 lg:grid-cols-5"><div class="lg:col-span-2"><p class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">L'offre</p><h2 class="mt-3 text-3xl font-bold">Accès à vie CommunityGlows</h2><p class="mt-4 text-muted-foreground">Commencez par une période complète de 30 jours sans carte ni facturation automatique. Vous pouvez relancer l’essai deux fois. Après la troisième période, l’achat via Stripe est obligatoire pour continuer les actions protégées.</p></div><div class="rounded-2xl border border-foreground/30 bg-card p-6 shadow-2xl lg:col-span-3 sm:p-8"><p class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">Offre fondateur</p><h3 class="mt-3 text-4xl font-bold">Accès à vie</h3><p class="mt-3 text-sm text-muted-foreground">Payez une fois, puis utilisez l'espace Pro pour organiser vos comptes, revenir aux conversations importantes et préserver le contexte communautaire.</p><div class="mt-6 grid gap-3 sm:grid-cols-2">{includes.map((item) => <div class="rounded-xl bg-background p-4 text-sm leading-relaxed text-muted-foreground">{item}</div>)}</div><div class="mt-6 grid gap-3 sm:grid-cols-2"><a href={appUrl()} class="shimmer-btn inline-flex w-full justify-center rounded-full bg-white px-6 py-4 text-sm font-semibold text-zinc-950 hover:bg-zinc-200">Essayer 30 jours gratuitement</a><a href={purchaseUrl} class="inline-flex w-full justify-center rounded-full border border-border px-6 py-4 text-sm font-semibold hover:bg-muted">Ouvrir l’app pour payer avec Stripe</a></div></div></section>
    <section class="mx-auto max-w-6xl px-4 py-16"><div class="rounded-2xl border border-border bg-card p-6 sm:p-8"><h2 class="text-3xl font-bold">À quoi vous attendre lorsque le produit évolue</h2><div class="mt-6 grid gap-3 md:grid-cols-2">{boundaries.map((item) => <div class="rounded-xl border border-border bg-background p-4 text-sm leading-relaxed text-muted-foreground">{item}</div>)}</div></div></section>
    <section class="mx-auto max-w-6xl px-4 py-16"><h2 class="text-3xl font-bold">Questions sur l'accès à vie</h2><div class="mt-6 grid gap-4">{faq.map((item) => <div class="rounded-xl border border-border bg-card p-5"><h3 class="font-semibold">{item.q}</h3><p class="mt-2 text-sm leading-relaxed text-muted-foreground">{item.a}</p></div>)}</div></section>
    <section class="mx-auto max-w-6xl px-4 py-16"><div class="rounded-2xl bg-white p-8 text-zinc-950 sm:p-10"><div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between"><div class="max-w-2xl"><h2 class="text-3xl font-bold">Faites plus de place aux personnes de votre communauté.</h2><p class="mt-4 text-zinc-600">Choisissez l'accès à vie et construisez un rythme plus serein autour de l'écoute, des réponses et du suivi.</p></div><div class="flex flex-col gap-3 sm:flex-row"><a href={appUrl()} class="inline-flex justify-center rounded-full bg-zinc-950 px-6 py-3 text-sm font-semibold text-white hover:bg-zinc-800">Essayer 30 jours gratuitement</a><a href={purchaseUrl} class="inline-flex justify-center rounded-full border border-zinc-300 px-6 py-3 text-sm font-semibold text-zinc-950 hover:bg-zinc-100">Ouvrir l’app pour payer avec Stripe</a></div></div></div></section>
    <Footer lang="fr" languageHref="/lifetime-deal" />
  </main>
</Layout>
