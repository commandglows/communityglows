---
import Layout from '../../layouts/Layout.astro'
import Navbar from '../../components/Navbar.astro'
import Hero from '../../components/Hero.astro'
import LogoMarquee from '../../components/LogoMarquee.astro'
import ProblemSection from '../../components/ProblemSection.astro'
import HumanConnection from '../../components/HumanConnection.astro'
import SolutionSection from '../../components/SolutionSection.astro'
import BentoGrid from '../../components/BentoGrid.astro'
import Testimonials from '../../components/Testimonials.astro'
import CommunityRhythm from '../../components/CommunityRhythm.astro'
import Pricing from '../../components/Pricing.astro'
import FinalCTA from '../../components/FinalCTA.astro'
import Newsletter from '../../components/Newsletter.astro'
import Footer from '../../components/Footer.astro'
import '../../styles/landing.css'
---

<Layout
  title="CommunityGlows — Votre travail social, sans le chaos des onglets"
  description="Gérez vos comptes, réseaux et tâches sociales dans un espace calme, avec des profils séparés et moins de distractions."
  path="/fr"
  lang="fr"
>
  <main id="main-content" class="min-h-screen bg-background text-foreground">
    <Navbar lang="fr" />
    <Hero lang="fr" />
    <LogoMarquee lang="fr" />
    <ProblemSection lang="fr" />
    <HumanConnection lang="fr" />
    <SolutionSection lang="fr" />
    <BentoGrid lang="fr" />
    <Testimonials lang="fr" />
    <CommunityRhythm lang="fr" />
    <Pricing lang="fr" />
    <FinalCTA lang="fr" />
    <Newsletter lang="fr" />
    <Footer lang="fr" />
  </main>
</Layout>
