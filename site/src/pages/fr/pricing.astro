---
import Layout from '../../layouts/Layout.astro'
import Navbar from '../../components/Navbar.astro'
import Pricing from '../../components/Pricing.astro'
import Newsletter from '../../components/Newsletter.astro'
import Footer from '../../components/Footer.astro'
import { siteUrl } from '../../config/site'

const jsonLd = [{
  '@context': 'https://schema.org', '@type': 'Product', name: 'CommunityGlows',
  description: 'Essayez pendant 30 jours toutes les fonctions CommunityGlows disponibles aujourd’hui, sans carte ni facturation automatique, puis achetez si vous le souhaitez l’accès à vie pour 79 €.',
  offers: { '@type': 'Offer', price: '79', priceCurrency: 'EUR', availability: 'https://schema.org/InStock', url: siteUrl('/fr/lifetime-deal') },
}]
---

<Layout title="Essai complet 30 jours, puis 79 € — CommunityGlows" description="Essayez toutes les fonctions disponibles aujourd’hui pendant 30 jours, sans carte bancaire ni facturation automatique. Choisissez ensuite l’accès à vie pour 79 €, sans abonnement." path="/fr/pricing" lang="fr" jsonLd={jsonLd}>
  <main id="main-content" class="min-h-screen bg-background text-foreground">
    <Navbar lang="fr" languageHref="/pricing" />
    <div class="pt-20"><Pricing lang="fr" /></div>
    <Newsletter lang="fr" />
    <Footer lang="fr" languageHref="/pricing" />
  </main>
</Layout>
