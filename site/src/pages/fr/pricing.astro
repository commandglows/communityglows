---
import Layout from '../../layouts/Layout.astro'
import Navbar from '../../components/Navbar.astro'
import Pricing from '../../components/Pricing.astro'
import Newsletter from '../../components/Newsletter.astro'
import Footer from '../../components/Footer.astro'


const jsonLd = [{
  '@context': 'https://schema.org', '@type': 'Product', name: 'CommunityGlows',
  description: 'Utilisez des périodes d’essai de 30 jours avec deux relances maximum, puis achetez l’accès à vie via Stripe pour continuer à utiliser CommunityGlows. La disponibilité publique du paiement est en cours de finalisation.',

}]
---

<Layout title="Préversion Windows et accès à vie à 149 € — CommunityGlows" description="Découvrez la préversion Windows. Essai prévu de 30 jours avec deux relances facultatives, puis 149 € TTC en une fois. Vérifiez la disponibilité dans l’application." path="/fr/pricing" lang="fr" jsonLd={jsonLd}>
  <main id="main-content" class="min-h-screen bg-background text-foreground">
    <Navbar lang="fr" languageHref="/pricing" />
    <div class="pt-20"><Pricing lang="fr" headingLevel="h1" /></div>
    <Newsletter lang="fr" />
    <Footer lang="fr" languageHref="/pricing" />
  </main>
</Layout>
