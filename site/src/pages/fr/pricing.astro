---
import Layout from '../../layouts/Layout.astro'
import Navbar from '../../components/Navbar.astro'
import Pricing from '../../components/Pricing.astro'
import Newsletter from '../../components/Newsletter.astro'
import Footer from '../../components/Footer.astro'
import { siteUrl } from '../../config/site'

const jsonLd = [{
  '@context': 'https://schema.org', '@type': 'Product', name: 'CommunityGlows',
  description: 'Utilisez des périodes d’essai de 30 jours avec deux relances maximum, puis achetez l’accès à vie via Stripe pour continuer les actions protégées.',
  offers: { '@type': 'Offer', price: '79', priceCurrency: 'EUR', availability: 'https://schema.org/InStock', url: siteUrl('/fr/lifetime-deal') },
}]
---

<Layout title="Périodes de 30 jours, puis 79 € — CommunityGlows" description="Commencez avec 30 jours et relancez deux fois maximum. Après la troisième période, achetez l’accès à vie via Stripe pour continuer, sans abonnement." path="/fr/pricing" lang="fr" jsonLd={jsonLd}>
  <main id="main-content" class="min-h-screen bg-background text-foreground">
    <Navbar lang="fr" languageHref="/pricing" />
    <div class="pt-20"><Pricing lang="fr" /></div>
    <Newsletter lang="fr" />
    <Footer lang="fr" languageHref="/pricing" />
  </main>
</Layout>
