---
import Layout from '../layouts/Layout.astro'
import Navbar from '../components/Navbar.astro'
import Pricing from '../components/Pricing.astro'
import Newsletter from '../components/Newsletter.astro'
import Footer from '../components/Footer.astro'
import { siteUrl } from '../config/site'

const jsonLd = [{
  '@context': 'https://schema.org', '@type': 'Product', name: 'CommunityGlows',
  description: 'Try every CommunityGlows feature available today for 30 days with no credit card or automatic billing, then optionally buy lifetime access for €79.',
  offers: { '@type': 'Offer', price: '79', priceCurrency: 'EUR', availability: 'https://schema.org/InStock', url: siteUrl('/lifetime-deal') },
}]
---

<Layout title="30-day full trial, then €79 once — CommunityGlows" description="Try every feature available today for 30 days with no credit card and no automatic billing. Then choose lifetime access for €79 once, with no subscription." path="/pricing" lang="en" jsonLd={jsonLd}>
  <main id="main-content" class="min-h-screen bg-background text-foreground">
    <Navbar languageHref="/fr/pricing" />
    <div class="pt-20"><Pricing lang="en" /></div>
    <Newsletter lang="en" />
    <Footer languageHref="/fr/pricing" />
  </main>
</Layout>
