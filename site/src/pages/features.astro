---
import Layout from '../layouts/Layout.astro'
import FeaturesPage from '../components/features/FeaturesPage.astro'
import { siteUrl } from '../config/site'

const jsonLd = [{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: siteUrl('/') },
    { "@type": "ListItem", position: 2, name: "Features", item: siteUrl('/features') },
  ],
}]
---

<Layout
  title="Features for more human social work — CommunityGlows"
  description="Discover how CommunityGlows helps you protect attention, preserve context, and build more consistent relationships with your audience and community."
  path="/features"
  lang="en"
  jsonLd={jsonLd}
>
  <FeaturesPage lang="en" />
</Layout>
