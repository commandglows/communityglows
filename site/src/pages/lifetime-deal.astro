---
import Layout from '../layouts/Layout.astro'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'
import { appUrl, authenticatedPurchaseUrl } from '../config/site'
import ActionLink from '../components/ui/ActionLink.astro'
import EyebrowPill from '../components/ui/EyebrowPill.astro'

const copy = {
  "title": "Trial and lifetime access — CommunityGlows",
  "description": "Windows preview, 30-day trial with two optional restarts and a €149 one-time price. Check terms and availability in the app.",
  "eyebrow": "Starting with Windows",
  "heading": "A workspace for your communities, without a subscription.",
  "intro": "Explore the Windows preview before choosing lifetime access. Bring profiles, networks and useful links into a dedicated workspace.",
  "download": "Download the Windows preview",
  "access": "Check access in the app",
  "note": "Public availability of trial and purchase journeys is being finalized. Downloading the preview does not guarantee that checkout is already available.",
  "price": "€149 · one-time payment",
  "offer": "The proposed terms",
  "trial": "One 30-day period with up to two optional restarts, no credit card and no automatic billing. After the third period, a purchase is required to continue using features that require paid access.",
  "includes": [
    "Windows workspace with separate profiles and local sessions",
    "Social network catalogue, custom links and focus preferences where supported",
    "Profiles and preferences sync through your account",
    "Local backup and restore"
  ],
  "boundaryTitle": "What to expect",
  "boundaries": [
    "Windows is currently the only publicly downloadable preview. Android and the Chrome and Firefox extensions are not publicly distributed yet.",
    "Bento, Scenes and Tasks are still evolving. Check your installed version’s release notes; upcoming improvements are not guaranteed to be in the current installer.",
    "Separate profiles reduce accidental session mix-ups. They do not bypass network rules or guarantee anonymity.",
    "Social networks can change their sign-in flows, interfaces and policies. Compatibility depends on each service.",
    "Profiles and preferences can sync; login sessions stay on the device unless explicitly exported in a backup."
  ],
  "faqTitle": "Access questions",
  "faq": [
    [
      "How does purchasing work?",
      "When available, open CommunityGlows and sign in. Checkout starts in the app and opens Stripe through CommandGlows. Confirm the price and terms before completing payment."
    ],
    [
      "Why does CommandGlows appear at checkout?",
      "CommandGlows manages Stripe payments and connects CommunityGlows access to your account."
    ],
    [
      "Does the trial restart automatically?",
      "No. The two restarts are optional and are started in the app when available. There is no automatic charge."
    ],
    [
      "Are upcoming features guaranteed?",
      "No. Choose the product for the features in the version you can use today. Future dates and availability are not promised."
    ],
    [
      "What if the app does not open?",
      "Install the Windows preview first, then open its access settings. Visit the help centre if the website link does not launch the app."
    ]
  ],
  "help": "Visit the help centre"
}
const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: copy.faq.map(([question, answer]) => ({
    '@type': 'Question', name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
}]
---

<Layout title={copy.title} description={copy.description} path="/lifetime-deal" lang="en" jsonLd={jsonLd}>
  <main id="main-content" class="min-h-screen bg-background text-foreground">
    <Navbar lang="en" languageHref="/fr/lifetime-deal" />
    <section class="mx-auto max-w-5xl px-4 pt-32 pb-16 text-center">
      <EyebrowPill>{copy.eyebrow}</EyebrowPill>
      <h1 class="mt-6 text-4xl sm:text-6xl font-bold tracking-tight">{copy.heading}</h1>
      <p class="mx-auto mt-6 max-w-3xl text-lg leading-relaxed text-muted-foreground">{copy.intro}</p>
      <div class="mt-8 flex flex-col sm:flex-row justify-center gap-4">
        <ActionLink href={appUrl('', 'en')} size="md">{copy.download}</ActionLink>
        <ActionLink href={authenticatedPurchaseUrl()} variant="secondary" size="md">{copy.access}</ActionLink>
      </div>
      <p class="mx-auto mt-6 max-w-3xl text-sm leading-relaxed text-muted-foreground">{copy.note}</p>
      <a class="mt-4 inline-block underline underline-offset-4" href="/help">{copy.help}</a>
    </section>
    <section class="mx-auto max-w-5xl px-4 py-12">
      <div class="rounded-2xl border border-border bg-card p-6 sm:p-10">
        <p class="text-sm text-muted-foreground">{copy.offer}</p>
        <h2 class="mt-3 text-3xl font-bold">{copy.price}</h2>
        <p class="mt-5 leading-relaxed text-muted-foreground">{copy.trial}</p>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2">
          {copy.includes.map(item => <li class="rounded-xl bg-background p-4">{item}</li>)}
        </ul>
      </div>
    </section>
    <section class="mx-auto max-w-5xl px-4 py-12">
      <h2 class="text-3xl font-bold">{copy.boundaryTitle}</h2>
      <ul class="mt-6 space-y-4">
        {copy.boundaries.map(item => <li class="rounded-xl border border-border bg-card p-5 leading-relaxed text-muted-foreground">{item}</li>)}
      </ul>
    </section>
    <section class="mx-auto max-w-5xl px-4 py-12 pb-20">
      <h2 class="text-3xl font-bold">{copy.faqTitle}</h2>
      <div class="mt-6 space-y-4">
        {copy.faq.map(([question, answer]) => <article class="rounded-xl border border-border bg-card p-5"><h3 class="font-semibold">{question}</h3><p class="mt-3 leading-relaxed text-muted-foreground">{answer}</p></article>)}
      </div>
    </section>
    <Footer lang="en" languageHref="/fr/lifetime-deal" />
  </main>
</Layout>
