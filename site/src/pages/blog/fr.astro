---
import Layout from '../../layouts/Layout.astro'
import Navbar from '../../components/Navbar.astro'
import Footer from '../../components/Footer.astro'
import { getCollection } from 'astro:content'
import { siteUrl } from '../../config/site'
import StatusBadge from '../../components/ui/StatusBadge.astro'

const posts = (await getCollection('blog')).filter(post => post.data.locale === 'fr').sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
)

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Blog",
    name: "CommunityGlows Blog",
    description: "Guides et conseils pour organiser vos réseaux avec CommunityGlows.",
    url: siteUrl('/blog/fr'),
    publisher: {
      "@type": "Organization",
      name: "CommunityGlows",
      logo: { "@type": "ImageObject", url: siteUrl('/icon-512.png') },
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Accueil", item: siteUrl('/fr') },
      { "@type": "ListItem", position: 2, name: "Blog", item: siteUrl('/blog/fr') },
    ],
  },
]
---

<Layout
  title="Blog - CommunityGlows"
  description="Guides et conseils pour organiser vos réseaux sociaux"
  path="/blog/fr"
  jsonLd={jsonLd}
  lang="fr"
  alternatePath="/blog"
>
  <main id="main-content" class="min-h-screen bg-background text-foreground">
    <Navbar lang="fr" alternatePath="/blog" />

    <section class="max-w-4xl mx-auto px-4 pt-32 pb-16">
      <div class="text-center mb-12">
        <h1 class="text-4xl sm:text-5xl font-bold text-foreground mb-4" style="font-family: var(--font-cal-sans);">
          Le blog CommunityGlows
        </h1>
        <p class="text-lg text-muted-foreground">Des guides pour comprendre et prendre en main votre espace de travail</p>
      </div>

      <nav aria-label="Langue du blog" class="flex justify-center gap-6 mb-8"><a href="/blog" lang="en" class="underline">English</a><span aria-current="page">Français</span></nav>
      <p class="text-muted-foreground mb-6">Commencez par <a class="underline" href="/blog/bien-demarrer-communityglows-guide-windows">le guide de prise en main Windows</a>. Les anciens articles non traduits restent accessibles depuis le blog anglais.</p>
      <div class="grid gap-6">
        {posts.map((post) => (
          <a
            href={`/blog/${post.id}`}
            class="site-interactive-card block rounded-2xl border border-border bg-card p-6 transition-all duration-300"
          >
            <div class="flex flex-wrap items-center gap-2 text-xs text-muted-foreground mb-3">
              <svg class="w-3 h-3" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
              <time datetime={post.data.date}>
                {new Date(post.data.date).toLocaleDateString('fr-FR', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
              {post.data.tags && post.data.tags.length > 0 && (
                <>
                  <span class="text-border">·</span>
                  {post.data.tags.slice(0, 3).map((tag) => (
                    <StatusBadge text={tag} tone="muted" />
                  ))}
                </>
              )}
            </div>
            <h2 class="text-xl font-semibold text-foreground group-hover:text-foreground/80 transition-colors mb-2">
              {post.data.title}
            </h2>
            <p class="text-muted-foreground text-sm line-clamp-2">{post.data.description}</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm text-foreground font-medium">
              Lire la suite
              <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </span>
          </a>
        ))}
      </div>
    </section>

    <Footer lang="fr" languageHref="/blog" />
  </main>
</Layout>
