---
import Layout from '../../layouts/Layout.astro'
import Navbar from '../../components/Navbar.astro'
import Footer from '../../components/Footer.astro'
import { appUrl } from '../../config/site'

const offerId = Astro.url.searchParams.get('offerId')
const isLifetimeDeal = offerId === 'communityglows/lifetime_deal'
const returnUrl = isLifetimeDeal ? '/lifetime-deal' : '/pricing'
---

<Layout
  title="Checkout Canceled - CommunityGlows"
  description="Your CommunityGlows checkout was canceled. You can retry directly from pricing."
  path="/purchase/cancel"
>
  <main id="main-content" class="min-h-screen bg-background text-foreground">
    <Navbar />
    <section class="mx-auto flex min-h-screen max-w-2xl flex-col items-center justify-center px-4 py-24 text-center">
      <h1 class="text-3xl font-bold text-foreground">Checkout canceled</h1>
      <p class="mt-4 text-muted-foreground">
        Your payment was not completed. You can return to {isLifetimeDeal ? 'the Lifetime Deal' : 'pricing'} and start again.
      </p>
      <p class="mt-2 text-muted-foreground">
        You can also open the app to review your current access status.
      </p>
      <div class="mt-8 flex flex-col gap-3">
        <a
          href={returnUrl}
          class="inline-flex items-center justify-center rounded-full bg-white px-5 py-3 text-sm font-semibold text-zinc-950 hover:bg-zinc-200"
        >
          {isLifetimeDeal ? 'Back to Lifetime Deal' : 'Back to pricing'}
        </a>
        <a
          href={appUrl()}
          class="inline-flex items-center justify-center rounded-full border border-border px-5 py-3 text-sm font-semibold text-foreground hover:bg-card"
        >
          Open CommunityGlows
        </a>
      </div>
    </section>
    <Footer />
  </main>
</Layout>
