---
import Layout from '../../layouts/Layout.astro'
import Navbar from '../../components/Navbar.astro'
import Footer from '../../components/Footer.astro'
import { appUrl } from '../../config/site'
import ActionLink from '../../components/ui/ActionLink.astro'

const offerId = Astro.url.searchParams.get('offerId')
const isLifetimeDeal = offerId === 'communityglows/lifetime_deal'
const returnUrl = isLifetimeDeal ? '/lifetime-deal' : '/pricing'
---

<Layout
  title="Checkout Success - CommunityGlows"
  description="Your CommunityGlows direct checkout request has been received. Open the app to finish access setup."
  path="/purchase/success"
>
  <main id="main-content" class="min-h-screen bg-background text-foreground">
    <Navbar />
    <section class="mx-auto flex min-h-screen max-w-2xl flex-col items-center justify-center px-4 py-24 text-center">
      <h1 class="text-3xl font-bold text-foreground">Thanks for your order</h1>
      <p class="mt-4 text-muted-foreground">
        If the payment is completed, your order status is now being synced to your CommunityGlows account.
      </p>
      <p class="mt-2 text-muted-foreground">
        You can open CommunityGlows and check access in the billing section.
      </p>
      <div class="mt-8 flex flex-col gap-3">
        <ActionLink href={appUrl()}>
          Open CommunityGlows
        </ActionLink>
        <ActionLink href={returnUrl} variant="secondary">
          {isLifetimeDeal ? 'Return to Lifetime Deal' : 'Return to pricing'}
        </ActionLink>
      </div>
    </section>
    <Footer />
  </main>
</Layout>
