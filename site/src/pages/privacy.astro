---
import Layout from '../layouts/Layout.astro'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'
import { contactEmail, siteUrl } from '../config/site'

const privacyEmail = contactEmail('privacy')

const jsonLd = [{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: siteUrl('/') },
    { "@type": "ListItem", position: 2, name: "Privacy Policy", item: siteUrl('/privacy') },
  ],
}]
---

<Layout title="Privacy Policy - CommunityGlows" description="Learn how CommunityGlows collects, uses, and protects your personal information." path="/privacy" jsonLd={jsonLd}>
  <main id="main-content" class="min-h-screen bg-background text-foreground">
    <Navbar />
    <div class="max-w-4xl mx-auto px-4 pt-32 pb-16">
      <h1 class="text-3xl font-bold text-foreground md:text-4xl">Privacy Policy</h1>
      <p class="mt-4 text-muted-foreground">Last updated: July 15, 2026</p>

      <div class="mt-8 space-y-8">
        <section>
          <h2 class="text-xl font-semibold text-foreground">1. Information We Collect</h2>
          <p class="mt-3 text-muted-foreground">When you use CommunityGlows, we collect information you provide directly to us, including:</p>
          <ul class="mt-3 list-disc space-y-2 pl-6 text-muted-foreground">
            <li>Account information (name, email address) when you sign up</li>
            <li>Preferences and settings you configure</li>
            <li>Profile and network link configuration</li>
            <li>Feature usage and app diagnostics needed to operate and support the service</li>
          </ul>
        </section>
        <section>
          <h2 class="text-xl font-semibold text-foreground">2. How We Use Your Information</h2>
          <p class="mt-3 text-muted-foreground">We use the information we collect to:</p>
          <ul class="mt-3 list-disc space-y-2 pl-6 text-muted-foreground">
            <li>Provide, maintain, and improve our services</li>
            <li>Store and sync your profiles and preferences across devices</li>
            <li>Send you technical notices and support messages</li>
            <li>Respond to your comments and questions</li>
          </ul>
        </section>
        <section>
          <h2 class="text-xl font-semibold text-foreground">3. Cookies and Sessions</h2>
          <p class="mt-3 text-muted-foreground">CommunityGlows can store live social cookies and session-related local storage on your device for the profile and network you open. App preferences and configuration may sync separately. A session backup is included only when you explicitly create an encrypted export.</p>
        </section>
        <section>
          <h2 class="text-xl font-semibold text-foreground">4. Data Security</h2>
          <p class="mt-3 text-muted-foreground">We use technical and organizational measures intended to protect account and app data. We do not claim that every third-party WebView session store is encrypted at rest; additional Android storage hardening remains required before a public Play release.</p>
        </section>
        <section>
          <h2 class="text-xl font-semibold text-foreground">5. Data Retention</h2>
          <p class="mt-3 text-muted-foreground">We retain account information while it is needed to provide the service or meet applicable obligations. Self-service account deletion is not currently available in the app.</p>
        </section>
        <section>
          <h2 class="text-xl font-semibold text-foreground">6. Your Rights</h2>
          <p class="mt-3 text-muted-foreground">You may contact us to request access, correction, export, or deletion of personal information. The public account-deletion workflow and in-app deletion controls are not yet complete; CommunityGlows must not be presented as Play-release ready until they are implemented and verified.</p>
        </section>
        <section id="account-deletion">
          <h2 class="text-xl font-semibold text-foreground">7. Account Deletion Requests</h2>
          <p class="mt-3 text-muted-foreground">To request account deletion, contact <a href={`mailto:${privacyEmail}?subject=Account%20deletion%20request`} class="text-foreground underline underline-offset-4 hover:opacity-80">{privacyEmail}</a>. This email request is not a substitute for the required in-app deletion control, which is not yet available.</p>
        </section>
        <section>
          <h2 class="text-xl font-semibold text-foreground">8. Contact Us</h2>
          <p class="mt-3 text-muted-foreground">If you have questions about this Privacy Policy, please contact us at <a href={`mailto:${privacyEmail}`} class="text-foreground underline underline-offset-4 hover:opacity-80">{privacyEmail}</a>.</p>
        </section>
      </div>

      <section class="mt-12 border-t border-border pt-8">
        <h2 class="text-lg font-semibold text-foreground">Related Pages</h2>
        <ul class="mt-4 flex flex-wrap gap-4">
          <li><a href="/terms" class="text-foreground underline underline-offset-4 hover:opacity-80">Terms of Service</a></li>
          <li><a href="/features" class="text-foreground underline underline-offset-4 hover:opacity-80">Features</a></li>
          <li><a href="/blog" class="text-foreground underline underline-offset-4 hover:opacity-80">Blog</a></li>
        </ul>
      </section>
    </div>
    <Footer />
  </main>
</Layout>
