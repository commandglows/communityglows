---
import { appUrl } from '../config/site'
import { getTranslations, type Locale } from '../i18n'
import ActionLink from './ui/ActionLink.astro'
import SectionHeading from './ui/SectionHeading.astro'

interface Props { lang?: Locale }
const { lang = 'en' } = Astro.props
const t = getTranslations(lang)
---

<section class="relative flex flex-col items-center justify-center px-4 pt-32 pb-20 overflow-hidden">
  <!-- Background gradient -->
  <div class="absolute inset-0 bg-gradient-to-b from-background via-background to-card pointer-events-none"></div>

  <!-- Subtle radial glow -->
  <div class="site-hero-glow absolute top-1/4 left-1/2 -translate-x-1/2 bg-foreground/5 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 max-w-5xl mx-auto text-center">
    <SectionHeading
      eyebrow={t.hero.badge}
      title={`${t.hero.title1} ${t.hero.title2}`}
      align="center"
      as="h1"
      titleClass="tracking-tight"
      containerClass="animate-fade-up delay-200"
      styleFont="var(--font-cal-sans)"
    />
    <p class:list={['animate-fade-up', 'delay-500', 'text-lg', 'sm:text-xl', 'text-muted-foreground', 'max-w-2xl', 'mx-auto', 'mb-10', 'leading-relaxed']}>
      {t.hero.subtitle}
    </p>

    <!-- CTAs -->
    <div class="animate-fade-up delay-600 flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
      <ActionLink href={appUrl()} size="md">
        {t.hero.cta}
        <svg class="w-4 h-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </ActionLink>
      <ActionLink href="#features" variant="secondary" size="md">
        {t.hero.secondaryCta}
      </ActionLink>
    </div>

    <!-- Social Proof -->
    <div class="animate-fade-up delay-700 flex flex-col items-center gap-4">
      <div class="flex items-center gap-2 text-sm text-muted-foreground">
      <span class="w-2 h-2 rounded-full bg-[var(--sg-color-success)] pulse-glow"></span>
        <span>{t.hero.socialProof}</span>
      </div>
    </div>
  </div>
</section>
