---
import { getTranslations, type Locale } from '../i18n'
import SiteLogo from './ui/SiteLogo.astro'
import EyebrowPill from './ui/EyebrowPill.astro'
interface Props { lang?: Locale; languageHref?: string }
const { lang = 'en', languageHref: languageHrefProp } = Astro.props
const t = getTranslations(lang)
const localized = (path: string) => lang === 'fr' ? `/fr${path}` : path
const footerLinks: Record<string, { label: string; href: string }[]> = {
  [t.footer.product]: [
    { label: t.footer.links.features, href: localized('/features') },
    { label: t.footer.links.pricing, href: localized('/pricing') },
    { label: t.footer.links.compare, href: localized('/compare') },
  ],
  [t.footer.resources]: [
    { label: t.footer.links.blog, href: '/blog' },
    { label: t.footer.links.downloads, href: localized('/download') },
    { label: t.footer.links.github, href: 'https://github.com/dianedef/CommunityGlows' },
  ],
  [t.footer.company]: [
    { label: t.footer.links.about, href: '#' },
    { label: t.footer.links.contact, href: '#' },
  ],
  [t.footer.legal]: [
    { label: t.footer.links.privacy, href: '/privacy' },
    { label: t.footer.links.terms, href: '/terms' },
  ],
}
const currentYear = new Date().getFullYear()
const homeHref = lang === 'fr' ? '/fr' : '/'
const languageHref = languageHrefProp ?? (lang === 'fr' ? '/' : '/fr')
---

<footer class="border-t border-border bg-background">
  <div class="max-w-6xl mx-auto px-4 py-16">
    <div class="grid grid-cols-2 md:grid-cols-5 gap-8" data-reveal>
      <!-- Brand -->
      <div class="col-span-2 md:col-span-1 animate-fade-up">
        <SiteLogo href={homeHref} />
        <p class="text-sm text-muted-foreground/70 mb-4">{t.footer.tagline}</p>
        <EyebrowPill class="gap-2" tone="default">
          <span class="w-2 h-2 rounded-full bg-[var(--sg-color-success)] pulse-glow"></span>
          <span>{t.footer.status}</span>
        </EyebrowPill>
      </div>

      <!-- Links -->
      {Object.entries(footerLinks).map(([title, links]) => (
        <div class="animate-fade-up">
          <h4 class="text-sm font-semibold text-foreground mb-4">{title}</h4>
          <ul class="space-y-3">
            {links.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-muted-foreground/70 hover:text-foreground transition-colors">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Bottom -->
    <div class="mt-16 pt-8 border-t border-border flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-sm text-muted-foreground/70">{t.footer.copyright.replace('{year}', String(currentYear))}</p>
      <div class="flex items-center gap-6">
        <a href={languageHref} class="text-sm text-muted-foreground/70 hover:text-foreground transition-colors">{t.footer.links.language}</a>
        <a href="https://github.com/dianedef/CommunityGlows" class="text-sm text-muted-foreground/70 hover:text-foreground transition-colors">GitHub</a>
      </div>
    </div>
  </div>
</footer>
