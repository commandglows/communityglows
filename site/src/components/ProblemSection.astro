---
import { getTranslations, type Locale } from '../i18n'
interface Props { lang?: Locale }
const { lang = 'en' } = Astro.props
const t = getTranslations(lang)
---

<section class="py-16 sm:py-24 bg-card">
  <div class="max-w-6xl mx-auto px-4">
    <div class="text-center mb-12 sm:mb-16" data-reveal>
      <h2
        class="animate-fade-up text-3xl sm:text-4xl font-bold text-foreground mb-4"
        style="font-family: var(--font-instrument-sans);"
      >
        {t.problem.title}
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" data-reveal>
      {t.problem.items.map((problem, index) => (
        <div
          class={`animate-fade-up delay-${(index + 1) * 100} group relative p-6 rounded-2xl bg-background border border-border hover:border-foreground/25 hover:-translate-y-1 transition-all duration-300 text-center`}
        >
          <span class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-muted text-4xl sm:text-5xl mb-5">{problem.icon}</span>
          <h3 class="text-xl font-semibold text-foreground mb-3">{problem.title}</h3>
          <p class="text-base text-muted-foreground leading-relaxed">{problem.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
