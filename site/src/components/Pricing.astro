---
import { appUrl, authenticatedPurchaseUrl } from '../config/site'
import { getTranslations, type Locale } from '../i18n'
interface Props { lang?: Locale }
const { lang = 'en' } = Astro.props
const t = getTranslations(lang)
const purchaseUrl = authenticatedPurchaseUrl()
---

<section id="pricing" class="py-16 sm:py-24 bg-background">
  <div class="max-w-6xl mx-auto px-4">
    <div class="text-center mb-12" data-reveal>
      <p class="animate-fade-up inline-flex rounded-full border border-border bg-card px-4 py-2 text-xs font-semibold uppercase tracking-widest text-muted-foreground">{t.pricing.badge}</p>
      <h2 class="animate-fade-up delay-100 mt-5 text-3xl sm:text-5xl font-bold text-foreground" style="font-family: var(--font-instrument-sans);">{t.pricing.title}</h2>
      <p class="animate-fade-up delay-200 mt-5 text-lg text-muted-foreground max-w-2xl mx-auto leading-relaxed">{t.pricing.subtitle}</p>
    </div>

    <div class="mx-auto max-w-5xl rounded-2xl border border-foreground/30 bg-card p-6 shadow-2xl sm:p-10" data-reveal>
      <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
        <div class="text-center lg:text-left">
          <p class="text-sm font-semibold uppercase tracking-widest text-muted-foreground">{t.pricing.name}</p>
          <div class="mt-5 flex items-baseline justify-center gap-2 lg:justify-start">
            <span class="text-6xl font-bold text-foreground">€{t.pricing.price}</span>
          </div>
          <p class="mt-2 text-sm text-muted-foreground">{t.pricing.priceSuffix}</p>
          <div class="mt-7 flex flex-col gap-3">
            <a href={appUrl()} class="shimmer-btn inline-flex w-full items-center justify-center rounded-full bg-white px-7 py-3.5 text-sm font-semibold text-zinc-950 transition-colors hover:bg-zinc-200">{t.pricing.cta}</a>
            <a href={purchaseUrl} class="inline-flex w-full items-center justify-center rounded-full border border-border px-7 py-3.5 text-sm font-semibold text-foreground transition-colors hover:bg-muted">{t.pricing.purchaseCta}</a>
          </div>
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          <div class="rounded-2xl border border-border bg-background p-6">
            <h3 class="text-lg font-semibold text-foreground">{t.pricing.availableTitle}</h3>
            <ul class="mt-5 space-y-3">
              {t.pricing.available.map((feature) => (
                <li class="flex items-start gap-3 text-sm leading-relaxed text-foreground/85">
                  <svg class="mt-0.5 h-4 w-4 shrink-0 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                  {feature}
                </li>
              ))}
            </ul>
          </div>
          <div class="rounded-2xl border border-border bg-background p-6">
            <h3 class="text-lg font-semibold text-foreground">{t.pricing.roadmapTitle}</h3>
            <ul class="mt-5 space-y-3">
              {t.pricing.roadmap.map((feature) => (
                <li class="flex items-start gap-3 text-sm leading-relaxed text-muted-foreground">
                  <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-muted-foreground" aria-hidden="true"></span>
                  {feature}
                </li>
              ))}
            </ul>
            <p class="mt-5 border-t border-border pt-4 text-xs leading-relaxed text-muted-foreground">{t.pricing.roadmapNote}</p>
            <div class="mt-5 border-t border-border pt-5">
              <h4 class="text-sm font-semibold text-foreground">{t.pricing.plannedTitle}</h4>
              <ul class="mt-3 flex flex-wrap gap-2">
                {t.pricing.planned.map((platform) => (
                  <li class="rounded-full border border-border bg-card px-3 py-1.5 text-xs text-muted-foreground">{platform}</li>
                ))}
              </ul>
              <p class="mt-4 text-xs leading-relaxed text-muted-foreground">{t.pricing.plannedNote}</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-10 max-w-3xl mx-auto px-6 py-5 rounded-2xl bg-card/50 border border-border text-sm leading-relaxed text-muted-foreground" data-reveal>
      <p><span class="font-medium text-foreground">{t.pricing.whyTitle}</span> {t.pricing.whyBody}</p>
    </div>
  </div>
</section>
