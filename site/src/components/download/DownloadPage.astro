---
import Footer from '../Footer.astro'
import Navbar from '../Navbar.astro'
import { downloadPlatforms } from '../../config/downloads'
import type { Locale } from '../../i18n'
import ActionLink from '../ui/ActionLink.astro'
import EyebrowPill from '../ui/EyebrowPill.astro'
import StatusBadge from '../ui/StatusBadge.astro'

interface Props { lang: Locale }
const { lang } = Astro.props
const copy = lang === 'fr' ? {
  eyebrow: 'Télécharger CommunityGlows', title: 'Commencez sur Windows.', intro: 'La préversion Windows est le premier téléchargement public. Consultez ses notes de version pour connaître les fonctionnalités incluses. Android et les extensions Chrome et Firefox ne sont pas encore distribués publiquement.', available: 'Préversion publique', releasePage: 'Voir les versions', comingSoon: 'Pas encore disponible',
  windows: { title: 'Windows', detail: 'Installeur de la préversion Windows. Le produit évolue encore ; les fonctionnalités peuvent différer des aperçus des prochaines versions.', action: 'Télécharger pour Windows' }, linux: { title: 'Linux', detail: 'Aucun téléchargement public Linux n’est proposé actuellement.', action: '' }, android: { title: 'Android', detail: 'Le téléchargement Android public n’est pas encore disponible. Aucune date n’est annoncée.', action: '' }, apple: { title: 'macOS, iPhone et iPad', detail: 'CommunityGlows n’est pas encore distribué publiquement sur les appareils Apple.', action: '' },
} : {
  eyebrow: 'Download CommunityGlows', title: 'Start on Windows.', intro: 'The Windows preview is our first public download. Read its release notes to check which features are included. Android and the Chrome and Firefox extensions are not publicly distributed yet.', available: 'Public preview', releasePage: 'View releases', comingSoon: 'Not yet available',
  windows: { title: 'Windows', detail: 'Installer for the Windows preview. The product is still evolving; included features may differ from previews of upcoming versions.', action: 'Download for Windows' }, linux: { title: 'Linux', detail: 'No public Linux download is currently offered.', action: '' }, android: { title: 'Android', detail: 'A public Android download is not available yet. No release date is announced.', action: '' }, apple: { title: 'macOS, iPhone and iPad', detail: 'CommunityGlows is not publicly distributed on Apple devices yet.', action: '' },
}
---

<main id="main-content" class="min-h-screen bg-background text-foreground">
  <Navbar lang={lang} languageHref={lang === 'fr' ? '/download' : '/fr/download'} />
  <section class="mx-auto max-w-5xl px-4 pb-16 pt-32 text-center sm:pb-20" data-reveal>
    <EyebrowPill class="animate-fade-up">{copy.eyebrow}</EyebrowPill>
    <h1 class="animate-fade-up delay-100 mx-auto mt-5 max-w-3xl text-4xl font-bold tracking-tight text-foreground sm:text-5xl lg:text-6xl" style="font-family: var(--font-cal-sans);">{copy.title}</h1>
    <p class="animate-fade-up delay-200 mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-muted-foreground">{copy.intro}</p>
    <nav class="mt-6 flex flex-wrap justify-center gap-5" aria-label={lang === 'fr' ? 'Avant de commencer' : 'Before you start'}>
      <a class="underline" href="https://github.com/commandglows/communityglows/releases/tag/windows-latest">{lang === 'fr' ? 'Notes de la préversion Windows' : 'Windows preview release notes'}</a>
      <a class="underline" href={lang === 'fr' ? '/blog/bien-demarrer-communityglows-guide-windows' : '/blog/getting-started-with-video-notes'}>{lang === 'fr' ? 'Guide d’installation et de prise en main' : 'Installation and getting-started guide'}</a>
    </nav>
  </section>
  <section class="mx-auto max-w-5xl px-4 pb-20 sm:pb-28" aria-label={copy.eyebrow}>
    <div class="grid gap-5 sm:grid-cols-2" data-reveal>
      {downloadPlatforms.map((platform) => {
        const details = copy[platform.id]
        const active = platform.availability !== 'coming-soon'
        const status = platform.availability === 'available' ? copy.available : platform.availability === 'release-page' ? copy.releasePage : copy.comingSoon
        return <article class:list={['animate-fade-up flex min-h-64 flex-col rounded-2xl border p-6 text-left sm:p-7', active ? 'border-border bg-card' : 'border-border bg-muted/40']} data-release-status={platform.availability}>
          <div class="flex items-start justify-between gap-4"><div class="flex h-12 w-12 items-center justify-center rounded-xl bg-muted text-foreground" aria-hidden="true"><svg viewBox="0 0 24 24" class="h-6 w-6" set:html={platform.iconBody} /></div><StatusBadge text={status} tone={active ? 'default' : 'muted'} /></div>
          <div class="mt-7"><h2 class="text-2xl font-semibold text-foreground">{details.title}</h2><p class="mt-3 leading-relaxed text-muted-foreground">{details.detail}</p></div>
<div class="mt-auto pt-7">
  {active && platform.href ? (
    <ActionLink href={platform.href} class="w-full" rel="noreferrer">
      {details.action}
    </ActionLink>
  ) : (
    <StatusBadge text={copy.comingSoon} />
  )}
</div>
        </article>
      })}
    </div>
  </section>
  <Footer lang={lang} languageHref={lang === 'fr' ? '/download' : '/fr/download'} />
</main>
