---
import { appUrl } from '../config/site'
import { getTranslations, type Locale } from '../i18n'
import ActionLink from './ui/ActionLink.astro'
interface Props { lang?: Locale }
const { lang = 'en' } = Astro.props
const t = getTranslations(lang)
---

<section class="py-16 sm:py-24 bg-background">
  <div class="max-w-4xl mx-auto px-4 text-center" data-reveal>
    <h2 class="animate-fade-up-slow text-3xl sm:text-5xl lg:text-6xl font-bold text-foreground mb-6 tracking-tight" style="font-family: var(--font-cal-sans);">
      {t.finalCta.title}
    </h2>
    <p class="animate-fade-up delay-200 text-lg sm:text-xl text-muted-foreground mb-10 max-w-2xl mx-auto leading-relaxed">
      {t.finalCta.subtitle}
    </p>

    <div class="animate-fade-up delay-300 flex flex-col sm:flex-row items-center justify-center gap-4">
      <ActionLink href={appUrl()} size="lg">
        {t.finalCta.cta}
        <svg class="w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </ActionLink>
      <ActionLink href="#features" variant="secondary" size="lg">
        {t.finalCta.secondaryCta}
      </ActionLink>
    </div>
  </div>
</section>
