---
interface Props {
  label?: string
  href?: string
  size?: 'sm' | 'md'
}

const { label = 'CommunityGlows', href = '/', size = 'md' } = Astro.props
const badgeClass = size === 'sm' ? 'w-8 h-8 rounded-lg text-sm' : 'w-10 h-10 rounded-xl text-base'
---

<a href={href} class="flex items-center gap-2">
  <div class:list={[badgeClass, 'bg-primary flex items-center justify-center']}>
    <svg
      viewBox="0 0 32 32"
      class="text-primary-foreground"
      fill="currentColor"
      aria-hidden="true"
    >
      <path d="M12 9.5v13l11-6.5L12 9.5Z" />
      <rect x="20" y="14" width="2.5" height="9" rx="1.25" />
    </svg>
  </div>
  <span class:list={[size === 'sm' ? 'font-semibold text-sm' : 'font-semibold text-base', 'text-foreground']}>
    {label}
  </span>
</a>

