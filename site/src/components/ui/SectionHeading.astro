---
interface Props {
  eyebrow?: string
  title: string
  subtitle?: string
  align?: 'left' | 'center'
  titleClass?: string
  eyebrowClass?: string
  subtitleClass?: string
  as?: 'h1' | 'h2' | 'h3'
  id?: string
  fontVariant?: 'display' | 'editorial'
  containerClass?: string
}

const {
  eyebrow,
  title,
  subtitle,
  align = 'center',
  titleClass = '',
  eyebrowClass = '',
  subtitleClass = '',
  as = 'h2',
  id,
  fontVariant,
  containerClass = '',
} = Astro.props

const baseAlignClass = align === 'left' ? '' : 'text-center'
const defaultTitleClass =
  as === 'h1'
    ? 'text-4xl sm:text-5xl lg:text-6xl font-bold text-foreground'
    : 'text-3xl sm:text-4xl font-bold text-foreground'
const defaultEyebrowClass = 'text-sm font-medium text-muted-foreground uppercase tracking-widest mb-2'
const fontVariantClass = fontVariant === 'display'
  ? 'site-heading-font-display'
  : fontVariant === 'editorial'
    ? 'site-heading-font-editorial'
    : ''

const Tag = as
---

<header class:list={['mb-12 sm:mb-16', baseAlignClass, containerClass]}>
  {eyebrow && (
    <p class:list={[defaultEyebrowClass, eyebrowClass]}>{eyebrow}</p>
  )}
  <Tag
    id={id}
    class:list={[defaultTitleClass, fontVariantClass, titleClass]}
  >
    {title}
  </Tag>
  {subtitle && <p class:list={['mt-4 text-muted-foreground', subtitleClass]}>{subtitle}</p>}
</header>
