---
interface Props {
  tag?: 'p' | 'span'
  tone?: 'default' | 'success'
  class?: string
}

const {
  tag: Tag = 'span',
  tone = 'default',
  class: className = '',
} = Astro.props

const toneClass =
  tone === 'success'
    ? 'border-[var(--sg-color-success)]/25 text-[var(--sg-color-success)] bg-[var(--sg-color-success)]/8'
    : 'border-border bg-card text-muted-foreground'
---

<Tag class:list={['inline-flex rounded-full border px-4 py-2 text-xs font-semibold uppercase tracking-widest', toneClass, className]}>
  <slot />
</Tag>
