---
import { getTranslations, type Locale } from '../i18n'
import EyebrowPill from './ui/EyebrowPill.astro'
interface Props { lang?: Locale }
const { lang = 'en' } = Astro.props
const t = getTranslations(lang)
---

<section class="py-20 sm:py-28 bg-background overflow-hidden">
  <div class="max-w-6xl mx-auto px-4">
    <div class="max-w-3xl mx-auto text-center mb-14 sm:mb-16" data-reveal>
      <EyebrowPill class="animate-fade-up">{t.humanConnection.label}</EyebrowPill>
      <h2 class="animate-fade-up delay-100 text-3xl sm:text-5xl font-bold text-foreground mb-6" style="font-family: var(--font-instrument-sans);">
        {t.humanConnection.title}
      </h2>
      <p class="animate-fade-up delay-200 text-lg sm:text-xl text-muted-foreground leading-relaxed">
        {t.humanConnection.intro}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4" data-reveal>
      {t.humanConnection.items.map((item, index) => (
        <article class={`animate-fade-up delay-${(index + 1) * 100} p-7 sm:p-8 rounded-2xl bg-card border border-border text-center hover:border-foreground/25 hover:-translate-y-1 transition-all duration-300`}>
          <span class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-muted text-4xl mb-6" aria-hidden="true">{item.icon}</span>
          <h3 class="text-xl font-semibold text-foreground mb-4">{item.title}</h3>
          <p class="text-base text-muted-foreground leading-relaxed">{item.desc}</p>
        </article>
      ))}
    </div>

    <div class="max-w-4xl mx-auto mt-12 sm:mt-16 p-7 sm:p-10 rounded-2xl bg-card border border-border text-center" data-reveal>
      <p class="animate-fade-up text-xl sm:text-2xl text-foreground leading-relaxed" style="font-family: var(--font-instrument-sans);">
        {t.humanConnection.manifesto}
      </p>
    </div>
  </div>
</section>
