<section id="features" class="py-16 sm:py-24 bg-background">
  <div class="max-w-6xl mx-auto px-4">
    <div class="text-center mb-12 sm:mb-16" data-reveal>
      <p class="animate-fade-up text-sm font-medium text-muted-foreground uppercase tracking-wider mb-2">Features</p>
      <h2 class="animate-fade-up delay-100 text-3xl sm:text-4xl font-bold text-foreground mb-4" style="font-family: var(--font-instrument-sans);">
        The details that keep the workflow moving
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" data-reveal>
      <!-- Profile-aware sessions (large card) -->
      <div class="md:col-span-2 animate-fade-up group relative p-6 rounded-2xl bg-card border border-border hover:border-foreground/25 hover:scale-[1.02] transition-all duration-300 overflow-hidden">
        <div class="flex items-start justify-between">
          <div>
            <h3 class="text-lg sm:text-xl font-semibold text-foreground mb-2">A home for every workflow</h3>
            <p class="text-sm text-muted-foreground mb-4 leading-relaxed">
              Keep the right links, accounts, and next actions together for each client, project, or personal workspace.
            </p>
          </div>
          <!-- Profile organizer animation -->
          <div class="hidden sm:block w-[260px] shrink-0" id="playlist-organizer">
            <div class="flex flex-col gap-1" id="playlist-unsorted">
              <div class="flex items-center gap-2 px-2 py-1 rounded-md bg-muted/50">
                <div class="w-1.5 h-1.5 rounded-full shrink-0 bg-blue-500"></div>
                <span class="text-[10px] text-muted-foreground truncate">Client A / LinkedIn</span>
              </div>
              <div class="flex items-center gap-2 px-2 py-1 rounded-md bg-muted/50">
                <div class="w-1.5 h-1.5 rounded-full shrink-0 bg-purple-500"></div>
                <span class="text-[10px] text-muted-foreground truncate">Personal / X</span>
              </div>
              <div class="flex items-center gap-2 px-2 py-1 rounded-md bg-muted/50">
                <div class="w-1.5 h-1.5 rounded-full shrink-0 bg-blue-500"></div>
                <span class="text-[10px] text-muted-foreground truncate">Client B / Instagram</span>
              </div>
              <div class="flex items-center gap-2 px-2 py-1 rounded-md bg-muted/50">
                <div class="w-1.5 h-1.5 rounded-full shrink-0 bg-purple-500"></div>
                <span class="text-[10px] text-muted-foreground truncate">Team / Gmail</span>
              </div>
              <div class="flex items-center gap-2 px-2 py-1 rounded-md bg-muted/50">
                <div class="w-1.5 h-1.5 rounded-full shrink-0 bg-blue-500"></div>
                <span class="text-[10px] text-muted-foreground truncate">Brand / TikTok</span>
              </div>
            </div>
          </div>
        </div>
        <span class="inline-block bg-foreground/10 text-foreground rounded-full px-3 py-1 text-sm mt-2">Less setup between tasks</span>
      </div>

      <!-- Network Dashboard -->
      <div class="animate-fade-up delay-100 group relative p-6 rounded-2xl bg-card border border-border hover:border-foreground/25 hover:scale-[1.02] transition-all duration-300">
        <h3 class="text-lg sm:text-xl font-semibold text-foreground mb-2">Your network, your starting point</h3>
        <p class="text-sm text-muted-foreground mb-4 leading-relaxed">
          Open the networks you already use from one launch point, with room for custom links when your workflow goes beyond social.
        </p>
        <span class="inline-block bg-foreground/10 text-foreground rounded-full px-3 py-1 text-sm">Start where the work is</span>
      </div>

      <!-- Fast Switching -->
      <div class="animate-fade-up delay-200 group relative p-6 rounded-2xl bg-card border border-border hover:border-foreground/25 hover:scale-[1.02] transition-all duration-300">
        <h3 class="text-lg sm:text-xl font-semibold text-foreground mb-2">Shortcuts for repeat work</h3>
        <p class="text-sm text-muted-foreground mb-4 leading-relaxed">
          Keep the actions you repeat every day within reach, so changing context does not mean starting over.
        </p>
        <div class="flex items-center gap-1 mb-4" id="kbd-container">
          <kbd class="kbd-key px-2 py-1 text-xs bg-muted border border-border rounded text-foreground/80 font-mono transition-transform duration-100">⌘</kbd>
          <kbd class="kbd-key px-2 py-1 text-xs bg-muted border border-border rounded text-foreground/80 font-mono transition-transform duration-100">K</kbd>
        </div>
        <span class="inline-block bg-foreground/10 text-foreground rounded-full px-3 py-1 text-sm">Make momentum easier</span>
      </div>

      <!-- Anti-Distraction Mode -->
      <div class="animate-fade-up delay-300 group relative p-6 rounded-2xl bg-card border border-border hover:border-foreground/25 hover:scale-[1.02] transition-all duration-300">
        <h3 class="text-lg sm:text-xl font-semibold text-foreground mb-2">Tune each surface</h3>
        <p class="text-sm text-muted-foreground mb-4 leading-relaxed">
          Set the appearance, media, and text preferences that help each network feel useful instead of overwhelming.
        </p>
        <span class="inline-block bg-foreground/10 text-foreground rounded-full px-3 py-1 text-sm">Design for attention</span>
      </div>

      <!-- Cross-Device Sync -->
      <div class="animate-fade-up delay-400 group relative p-6 rounded-2xl bg-card border border-border hover:border-foreground/25 hover:scale-[1.02] transition-all duration-300">
        <h3 class="text-lg sm:text-xl font-semibold text-foreground mb-2">Pick up where you left off</h3>
        <p class="text-sm text-muted-foreground mb-4 leading-relaxed">
          Your setup follows your account across supported devices, so your workspace feels familiar wherever you open it.
        </p>
        <svg viewBox="0 0 100 70" class="w-full h-24">
          <defs>
            <linearGradient id="chartGradient" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="rgb(255,255,255)" stop-opacity="0.2" />
              <stop offset="100%" stop-color="rgb(255,255,255)" stop-opacity="0" />
            </linearGradient>
          </defs>
          <path d="M 0 60 L 20 45 L 40 55 L 60 30 L 80 40 L 100 15 L 100 70 L 0 70 Z" fill="url(#chartGradient)" class="opacity-50" />
          <path d="M 0 60 L 20 45 L 40 55 L 60 30 L 80 40 L 100 15" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" class="draw-line" />
        </svg>
        <span class="inline-block bg-foreground/10 text-foreground rounded-full px-3 py-1 text-sm">Continue without reset</span>
      </div>

      <!-- Privacy-First -->
      <div class="animate-fade-up delay-500 group relative p-6 rounded-2xl bg-card border border-border hover:border-foreground/25 hover:scale-[1.02] transition-all duration-300">
        <h3 class="text-lg sm:text-xl font-semibold text-foreground mb-2">Keep live sessions local</h3>
        <p class="text-sm text-muted-foreground mb-4 leading-relaxed">
          Connected sessions stay on the device unless you explicitly move them with an encrypted backup export.
        </p>
        <div class="flex items-center gap-2 mb-4">
          <span class="px-2 py-1 text-xs bg-muted rounded text-muted-foreground">Local</span>
          <span class="px-2 py-1 text-xs bg-muted rounded text-muted-foreground">Encrypted backup</span>
          <span class="px-2 py-1 text-xs bg-muted rounded text-muted-foreground">Profile scoped</span>
        </div>
        <span class="inline-block bg-foreground/10 text-foreground rounded-full px-3 py-1 text-sm">Control what travels</span>
      </div>
    </div>
  </div>
</section>

<script>
  // Keyboard shortcut press animation
  const keys = document.querySelectorAll<HTMLElement>('.kbd-key')
  setInterval(() => {
    keys.forEach((key, i) => {
      setTimeout(() => {
        key.style.transform = 'scale(0.95) translateY(2px)'
        setTimeout(() => {
          key.style.transform = ''
        }, 200)
      }, i * 50)
    })
  }, 3000)
</script>
