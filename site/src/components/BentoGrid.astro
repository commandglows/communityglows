---
import { getTranslations, type Locale } from '../i18n'
import EyebrowPill from './ui/EyebrowPill.astro'
import StatusBadge from './ui/StatusBadge.astro'
interface Props { lang?: Locale }
const { lang = 'en' } = Astro.props
const t = getTranslations(lang)
const features = t.features.items
const previewLabels = lang === 'fr'
  ? ['Client A / LinkedIn', 'Personnel / X', 'Client B / Instagram', 'Équipe / Gmail', 'Marque / TikTok']
  : ['Client A / LinkedIn', 'Personal / X', 'Client B / Instagram', 'Team / Gmail', 'Brand / TikTok']
---

<section id="features" class="py-16 sm:py-24 bg-background">
  <div class="max-w-6xl mx-auto px-4">
    <div class="text-center mb-12 sm:mb-16" data-reveal>
      <EyebrowPill class="animate-fade-up mb-2">{t.features.label}</EyebrowPill>
      <h2 class="animate-fade-up delay-100 text-3xl sm:text-4xl font-bold text-foreground mb-4" style="font-family: var(--font-instrument-sans);">
        {t.features.title}
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" data-reveal>
      <!-- Profile-aware sessions (large card) -->
      <div class="md:col-span-2 animate-fade-up site-interactive-card group relative p-6 rounded-2xl bg-card border border-border transition-all overflow-hidden">
        <div class="flex items-start justify-between">
          <div>
            <h3 class="text-lg sm:text-xl font-semibold text-foreground mb-2">{features[0].title}</h3>
            <p class="text-sm text-muted-foreground mb-4 leading-relaxed">
              {features[0].desc}
            </p>
          </div>
          <!-- Profile organizer animation -->
          <div class="site-feature-preview hidden sm:block shrink-0" id="playlist-organizer">
            <div class="flex flex-col gap-1" id="playlist-unsorted">
              <div class="site-surface-muted-half flex items-center gap-2 px-2 py-1 rounded-md">
                <div class="w-1.5 h-1.5 rounded-full shrink-0 bg-blue-500"></div>
                <span class="site-microcopy text-muted-foreground truncate">{previewLabels[0]}</span>
              </div>
              <div class="site-surface-muted-half flex items-center gap-2 px-2 py-1 rounded-md">
                <div class="w-1.5 h-1.5 rounded-full shrink-0 bg-purple-500"></div>
                <span class="site-microcopy text-muted-foreground truncate">{previewLabels[1]}</span>
              </div>
              <div class="site-surface-muted-half flex items-center gap-2 px-2 py-1 rounded-md">
                <div class="w-1.5 h-1.5 rounded-full shrink-0 bg-blue-500"></div>
                <span class="site-microcopy text-muted-foreground truncate">{previewLabels[2]}</span>
              </div>
              <div class="site-surface-muted-half flex items-center gap-2 px-2 py-1 rounded-md">
                <div class="w-1.5 h-1.5 rounded-full shrink-0 bg-purple-500"></div>
                <span class="site-microcopy text-muted-foreground truncate">{previewLabels[3]}</span>
              </div>
              <div class="site-surface-muted-half flex items-center gap-2 px-2 py-1 rounded-md">
                <div class="w-1.5 h-1.5 rounded-full shrink-0 bg-blue-500"></div>
                <span class="site-microcopy text-muted-foreground truncate">{previewLabels[4]}</span>
              </div>
            </div>
          </div>
        </div>
        <StatusBadge text={features[0].tag} class="mt-2" />
      </div>

      <!-- Network Dashboard -->
      <div class="animate-fade-up delay-100 site-interactive-card group relative p-6 rounded-2xl bg-card border border-border transition-all">
        <h3 class="text-lg sm:text-xl font-semibold text-foreground mb-2">{features[1].title}</h3>
        <p class="text-sm text-muted-foreground mb-4 leading-relaxed">
          {features[1].desc}
        </p>
        <StatusBadge text={features[1].tag} />
      </div>

      <!-- Fast Switching -->
      <div class="animate-fade-up delay-200 site-interactive-card group relative p-6 rounded-2xl bg-card border border-border transition-all">
        <h3 class="text-lg sm:text-xl font-semibold text-foreground mb-2">{features[2].title}</h3>
        <p class="text-sm text-muted-foreground mb-4 leading-relaxed">
          {features[2].desc}
        </p>
        <div class="flex items-center gap-1 mb-4" id="kbd-container">
          <kbd class="kbd-key site-kbd px-2 py-1 text-xs bg-muted border border-border rounded font-mono transition-transform">⌘</kbd>
          <kbd class="kbd-key site-kbd px-2 py-1 text-xs bg-muted border border-border rounded font-mono transition-transform">K</kbd>
        </div>
        <StatusBadge text={features[2].tag} />
      </div>

      <!-- Anti-Distraction Mode -->
      <div class="animate-fade-up delay-300 site-interactive-card group relative p-6 rounded-2xl bg-card border border-border transition-all">
        <h3 class="text-lg sm:text-xl font-semibold text-foreground mb-2">{features[3].title}</h3>
        <p class="text-sm text-muted-foreground mb-4 leading-relaxed">
          {features[3].desc}
        </p>
        <StatusBadge text={features[3].tag} />
      </div>

      <!-- Cross-Device Sync -->
      <div class="animate-fade-up delay-400 site-interactive-card group relative p-6 rounded-2xl bg-card border border-border transition-all">
        <h3 class="text-lg sm:text-xl font-semibold text-foreground mb-2">{features[4].title}</h3>
        <p class="text-sm text-muted-foreground mb-4 leading-relaxed">
          {features[4].desc}
        </p>
        <svg viewBox="0 0 100 70" class="w-full h-24">
          <defs>
            <linearGradient id="chartGradient" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="currentColor" stop-opacity="var(--site-opacity-glow)" />
              <stop offset="100%" stop-color="currentColor" stop-opacity="var(--site-opacity-hidden)" />
            </linearGradient>
          </defs>
          <path d="M 0 60 L 20 45 L 40 55 L 60 30 L 80 40 L 100 15 L 100 70 L 0 70 Z" fill="url(#chartGradient)" class="site-chart-fill" />
          <path d="M 0 60 L 20 45 L 40 55 L 60 30 L 80 40 L 100 15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="draw-line" />
        </svg>
        <StatusBadge text={features[4].tag} />
      </div>

      <!-- Privacy-First -->
      <div class="animate-fade-up delay-500 site-interactive-card group relative p-6 rounded-2xl bg-card border border-border transition-all">
        <h3 class="text-lg sm:text-xl font-semibold text-foreground mb-2">{features[5].title}</h3>
        <p class="text-sm text-muted-foreground mb-4 leading-relaxed">
          {features[5].desc}
        </p>
        <div class="flex items-center gap-2 mb-4">
          {('badges' in features[5] ? features[5].badges : []).map((badge) => (
            <StatusBadge text={badge} tone="muted" class="px-2 py-1" />
          ))}
        </div>
        <StatusBadge text={features[5].tag} />
      </div>
    </div>
  </div>
</section>

<script>
  // Keyboard shortcut press animation
  const keys = document.querySelectorAll<HTMLElement>('.kbd-key')
  setInterval(() => {
    keys.forEach((key, i) => {
      setTimeout(() => {
        key.style.transform = 'scale(var(--site-scale-press)) translateY(var(--site-distance-press))'
        setTimeout(() => {
          key.style.transform = ''
        }, 200)
      }, i * 50)
    })
  }, 3000)
</script>
