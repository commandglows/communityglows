# metadata_schema_version: "1.0"
# project: communityglows
# updated: "2026-08-11"
# title: CommunityGlows environment variables
#
# Convex — required for auth and data persistence
# Get your URL from `npx convex dev` or the Convex dashboard
VITE_CONVEX_URL=

# Convex site domain used by Convex Auth (optional for local/dev configs)
CONVEX_SITE_URL=

# Billing / product access bridge
# Server/operator only. Never expose these in browser or mobile builds.
COMMUNITYGLOWS_BILLING_ADMIN_SECRET=
COMMUNITYGLOWS_SUITE_BRIDGE_URL=
COMMUNITYGLOWS_SUITE_BRIDGE_SECRET=
# Optional server-only Vercel preview protection bypass; never expose to clients.
COMMUNITYGLOWS_SUITE_BYPASS_SECRET=
# Non-secret canonical site origin used for Stripe success/cancel redirects.
COMMUNITYGLOWS_PUBLIC_SITE_URL=https://communityglows.com
# Stripe secrets, Price IDs and webhooks belong only to the central CommandGlows server.

# Optional runtime env (uncomment if your deploy pipeline uses these)
# CONVEX_DEPLOYMENT=
