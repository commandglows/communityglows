{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CommunityGlows",
  "version": "0.1.0",
  "identifier": "com.communityglows.desktop",
  "build": {
    "frontendDist": "../dist/tauri",
    "devUrl": "http://127.0.0.1:3006",
    "beforeDevCommand": "corepack pnpm run tauri:dev",
    "beforeBuildCommand": "corepack pnpm run tauri:build"
  },
  "app": {
    "windows": [
      {
        "title": "CommunityGlows",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "communityglows"
          ],
          "host": "auth-callback",
          "pathPrefix": [
            "/oauth"
          ]
        },
        {
          "scheme": [
            "https"
          ],
            "host": "communityglows.com",
          "pathPrefix": [
            "/auth/callback"
          ]
        },
        {
          "scheme": [
            "communityglows"
          ],
          "host": "app",
          "pathPrefix": [
            "/open"
          ]
        }
      ],
      "desktop": {
        "schemes": ["communityglows"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": { "installerHooks": "windows/onboarding-hooks.nsh" },
      "wix": {
        "fragmentPaths": ["windows/onboarding.wxs"],
        "componentRefs": ["OnboardingInstallationWitness"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
