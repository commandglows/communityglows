{
  "dependencies": {
    "@auth/core": "^0.41.1",
    "@convex-dev/auth": "^0.0.94",
    "@primeuix/themes": "^2.0.3",
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-dialog": "2.6.0",
    "@tauri-apps/plugin-fs": "2.4.5",
    "@vueuse/core": "^12.8.2",
    "convex": "^1.42.3",
    "notivue": "^2.4.5",
    "pinia": "^2.3.1",
    "pinia-plugin-persistedstate": "4.2.0",
    "primeflex": "^4.0.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "reka-ui": "^2.10.1",
    "vue": "^3.5.40",
    "vue-i18n": "^11.4.6",
    "vue-router": "^4.6.4",
    "webextension-polyfill": "^0.12.0"
  },
  "description": "Un projet Vue 3 + Vite pour la construction d'extensions Chrome",
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.39.4",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/simple-icons": "^1.2.92",
    "@intlify/unplugin-vue-i18n": "^6.0.8",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "2.10.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^20.19.41",
    "@types/webextension-polyfill": "^0.12.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/compiler-sfc": "^3.5.40",
    "autoprefixer": "^10.5.4",
    "chalk": "^5.6.2",
    "chrome-types": "^0.1.429",
    "commander": "^13.1.0",
    "concurrently": "^10.0.3",
    "convex-test": "^0.0.54",
    "cross-env": "^7.0.3",
    "daisyui": "^5.5.20",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^15.15.0",
    "postcss": "^8.5.19",
    "prettier": "^3.8.3",
    "sass": "^1.100.0",
    "tailwindcss": "^4.3.3",
    "terser": "^5.48.0",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.0",
    "unplugin-auto-import": "^19.3.0",
    "unplugin-icons": "^22.5.0",
    "unplugin-turbo-console": "^2.3.3",
    "unplugin-vue-components": "^28.8.0",
    "unplugin-vue-router": "^0.19.2",
    "vite": "^7.3.6",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vite-plugin-zip-pack": "^1.2.4",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.2.12",
    "web-ext": "^10.5.0"
  },
  "displayName": "Vite Vue 3 Chrome Extension",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "license": "UNLICENSED",
  "name": "vite-vue3-browser-extension-v3",
  "overrides": {
    "@crxjs/vite-plugin": "$@crxjs/vite-plugin"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/mubaidr/vite-vue3-browser-extension-v3"
  },
  "scripts": {
    "tauri:info": "pnpm exec tauri info",
    "tauri:dev": "vite -c vite.tauri.config.ts",
    "tauri:build": "vite build -c vite.tauri.config.ts",
    "tauri:bundle": "pnpm exec tauri build",
    "tauri:android:init": "pnpm exec tauri android init",
    "tauri:android:dev": "pnpm exec tauri android dev",
    "tauri:android:build": "pnpm exec tauri android build",
    "tauri:ios:init": "pnpm exec tauri ios init",
    "tauri:ios:dev": "pnpm exec tauri ios dev",
    "tauri:ios:build": "pnpm exec tauri ios build",
    "tauri": "pnpm exec tauri",
    "build": "corepack pnpm run build:chrome && corepack pnpm run build:firefox",
    "build:web": "corepack pnpm run build",
    "build:chrome": "cross-env NODE_ENV=production vite build -c vite.chrome.config.ts",
    "build:firefox": "cross-env NODE_ENV=production vite build -c vite.firefox.config.ts",
    "dev": "concurrently \"pnpm run dev:chrome\" \"pnpm run dev:firefox\"",
    "dev:chrome": "cross-env NODE_ENV=development vite -c vite.chrome.config.ts",
    "dev:firefox": "cross-env NODE_ENV=development vite build --mode development --watch -c vite.firefox.config.ts",
    "format": "prettier --write .",
    "launch": "tsx scripts/launch.ts",
    "launch:all": "tsx scripts/launch.ts --all",
    "billing:import-codes": "tsx scripts/importCommunityGlowsActivationCodes.ts",
    "design:tokens:bootstrap": "pnpm exec tsx scripts/design-tokens/generate.ts bootstrap",
    "design:tokens:generate": "pnpm exec tsx scripts/design-tokens/generate.ts generate",
    "design:tokens:check": "pnpm exec tsx scripts/design-tokens/generate.ts check",
    "design:tokens:validate": "pnpm exec tsx scripts/design-tokens/generate.ts validate",
    "lint": "eslint . --fix --cache",
    "lint:check": "eslint . --cache",
    "lint:manifest": "web-ext lint --source-dir dist/firefox --pretty",
    "test": "vitest",
    "test:once": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.core.json",
    "typecheck:core": "tsc --noEmit -p tsconfig.typecheck.core.json",
    "typecheck:full": "vue-tsc --noEmit -p tsconfig.json",
    "preview": "vite preview"
  },
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@8.11.0",
  "pnpm": {
    "overrides": {
      "@auth/core": "0.41.3",
      "adm-zip": "0.6.0",
      "shell-quote": "1.9.0",
      "immutable": "5.1.8",
      "fast-uri": "3.1.5",
      "undici": "7.29.0",
      "postcss": "8.5.25"
    }
  }
}
